# Docker Compose — порты и сервисы
# Скопируй в .env: copy .env.example .env

COMPOSE_PROJECT_NAME=etp

NGINX_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=8081
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

POSTGRES_DB=etp
POSTGRES_USER=etp
POSTGRES_PASSWORD=etp

# Не используйте *.local — pgAdmin 8+ отклоняет спец-домены (email-validator)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Xdebug (передаётся в контейнер backend-etp, не в Laravel)
XDEBUG_MODE=develop,debug
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003
PHP_IDE_CONFIG=serverName=etp

# SMTP для контейнера (Laravel читает MAIL_* из src/.env; хост сервиса Compose)
MAIL_MAILER=smtp
MAIL_HOST=mailhog-etp
MAIL_PORT=1025
