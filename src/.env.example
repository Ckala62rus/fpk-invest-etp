APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL в Docker (сервис postgres-etp). Тесты используют etp_test через phpunit.xml
DB_CONNECTION=pgsql
DB_HOST=postgres-etp
DB_PORT=5432
DB_DATABASE=etp
DB_USERNAME=etp
DB_PASSWORD=etp

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Broadcasting / Laravel Reverb (WebSocket, тикер аукциона)
# ---------------------------------------------------------------------------
# reverb          — живой Echo в SPA (нужен контейнер reverb-etp :6001)
# verifying_log   — без сокета: auth каналов в Postman + payload в laravel.log
#                   (см. documentation/agent-notes/09-websocket-how-to.md)
#
# Для проверки в реальном времени оставь reverb.
# После смены: docker compose restart backend-etp reverb-etp
#   и php artisan config:clear внутри backend-etp
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis-etp
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb
# - Браузер / Vite (VITE_REVERB_*): REVERB_HOST=localhost, порт 6001
# - PHP в Docker публикует события на REVERB_INTERNAL_HOST=reverb-etp
# - Ключ REVERB_APP_KEY должен совпадать с VITE_REVERB_APP_KEY на фронте
# - Порт на хосте задаётся ещё в backend/.env → REVERB_PORT (compose)
REVERB_APP_ID=etp
REVERB_APP_KEY=local-etp-reverb-key
REVERB_APP_SECRET=local-etp-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_INTERNAL_HOST=reverb-etp
REVERB_INTERNAL_PORT=6001
REVERB_INTERNAL_SCHEME=http

HORIZON_PATH=horizon
SENTRY_LARAVEL_DSN=

# MailHog в Docker (UI: http://localhost:8025). Тесты используют MAIL_MAILER=array из phpunit.xml
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog-etp
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@etp.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA (Vue dev server + Nginx API)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8200,127.0.0.1,127.0.0.1:5173,127.0.0.1:8200

# Spatie Activity Log
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_TABLE_NAME=activity_log

# Administrator Credentials (SuperAdminSeeder)
SUPER_ADMIN_INN=770000000000
SUPER_ADMIN_EMAIL=super_admin@example.com
SUPER_ADMIN_PASSWORD=password

# Demo users (DemoUsersSeeder) — локальная разработка SPA
DEMO_USERS_PASSWORD=password
TRADE_ADMIN_INN=770000000001
TRADE_ADMIN_EMAIL=trade_admin@example.com
PARTICIPANT_INN=770000000002
PARTICIPANT_EMAIL=participant@example.com
AUDITOR_INN=770000000003
AUDITOR_EMAIL=auditor@example.com
